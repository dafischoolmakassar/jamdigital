# Blokir akses langsung ke folder ini dari browser -- config.json & admin.json
# hanya boleh dibaca lewat script PHP di /api/, bukan diakses langsung via URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
